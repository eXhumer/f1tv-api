{
  "name": "@exhumer/f1tv-api",
  "version": "3.2.0",
  "description": "Unofficial F1TV API client for JavaScript/TypeScript",
  "keywords": [
    "f1tv",
    "f1-tv",
    "formula1",
    "formula-1",
    "f1",
    "motorsport",
    "api",
    "api-client",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "eXhumer",
    "email": "github@exhumer.cc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXhumer/f1tv-api.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0"
    },
    "packageManager": {
      "name": "npm"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --reporter=junit --outputFile=test-report.junit.xml"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "jose": "^6.2.12",
    "undici": "^8.12.2"
  }
}
